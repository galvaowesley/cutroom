 "cards": [
  {
   "dot": "rose",
   "title": "Install",
   "items": [
    "install.py copies the base skills (init, studio, script, brand) to every agent found, on Linux, macOS or Windows",
    "and the engine to the cutroom home: ~/.local/share/cutroom, %LOCALAPPDATA%\\cutroom, or any folder given with --home"
   ]
  },
  {
   "dot": "rose",
   "title": "Choose",
   "items": [
    "cutroom-init runs cutroom catalog: skills, tools and download sizes",
    "the person picks; cutroom setup <component> --yes downloads it and copies its skill to each agent"
   ]
  },
  {
   "dot": "rose",
   "title": "Skills and pinned tools",
   "items": [
    "14 skills: init, studio, script, brand, logo, deck, graphic, extract, diagram, iso3d, math, motion, voice, edit",
    "Docling 2.141, Archify 3.2, Anatomy 1.1, Hairline 0.5.1, ManimGX 0.1.1, HyperFrames 0.8.183, Kokoro v1.0, Chatterbox 0.1.7, logo-design 1.4.5"
   ]
  },
  {
   "dot": "rose",
   "title": "Parallel crew",
   "items": [
    "cutroom crew runs independent parts on Claude Code, Codex, Antigravity, Gemini CLI or Kiro at once",
    "each task follows a cutroom skill and writes only its own files; overlaps are refused before running"
   ]
  },
  {
   "dot": "rose",
   "title": "Yours",
   "items": [
    "brands/ and voices/ hold the person's brands, profiles and consented clones; they survive reinstalls",
    "every piece lands in its own folder: <date>-<slug>/{src,work,out}"
   ]
  }
 ]
}